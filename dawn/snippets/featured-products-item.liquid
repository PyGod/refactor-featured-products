<article
  class="featured-products__item {% if cart_items contains product.variants.first.id %}featured-products__item_hidden{% endif %}"
  id="featured-product-{{ product.variants.first.id }}"
  data-variant-id="{{ product.variants.first.id }}"
>
  <a href="{{ product.url }}" class="featured-products__link">
    {% if product.featured_image %}
      <picture>
        <source
          type="image/avif"
          media="(min-width: 1200px)"
          srcset="{{ product.featured_image | image_url: width: 4096, height: 2734 }}"
        >

        <source
          type="image/webp"
          media="(min-width: 1200px)"
          srcset="{{ product.featured_image | image_url: width: 4096, height: 2734 }}"
        >
        <source
          type="image/avif"
          media="(min-width: 992px)"
          srcset="{{ product.featured_image | image_url: width: 992, height: 590 }}"
        >

        <source
          type="image/webp"
          media="(min-width: 992px)"
          srcset="{{ product.featured_image | image_url: width: 992, height: 590 }}"
        >

        <source
          type="image/avif"
          media="(min-width: 768px)"
          srcset="{{ product.featured_image | image_url: width: 768, height: 457 }}"
        >

        <source
          type="image/webp"
          media="(min-width: 768px)"
          srcset="{{ product.featured_image | image_url: width: 768, height: 457 }}"
        >

        <source
          type="image/avif"
          media="(min-width: 576px)"
          srcset="{{ product.featured_image | image_url: width: 576, height: 343 }}"
        >

        <source
          type="image/webp"
          media="(min-width: 576px)"
          srcset="{{ product.featured_image | image_url: width: 576, height: 343 }}"
        >

        <img
          class="featured-products__image"
          src="{{ product.featured_image | image_url: width: 375, height: 260 }}"
          fetchpriority="high"
          alt=""
          width="375"
          height="260"
        >
      </picture>
    {% endif %}
    <h3 class="featured-products__title">{{ product.title }}</h3>
  </a>
  <button
    type="button"
    class="featured-products__button"
    data-variant-id="{{ product.variants.first.id }}"
  >
    Add to Cart -
    <span class="featured-products__price">{{ product.price | money }}</span>
  </button>
</article>
