<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {% render 'meta-tags' %}
    {{ content_for_header }}
    {{ 'main.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    {{ content_for_layout }}

    <!-- Подключаем JS без defer, чтобы он загружался сразу -->
    {{ 'bundle.js' | asset_url | script_tag }}

    <!-- Добавляем компонент на главную страницу -->
    {% if template == 'index' %}
      <featured-products data-collection="featured-products"></featured-products>
    {% endif %}
  </body>
</html>
