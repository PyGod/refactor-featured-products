{% comment %}
  <style> // Uncomment this style if you want to use classic Critical Css to avoid FOUC instead of inline class Critical Css
    {% for product in collections['featured-products'].products %}
      {% assign variantId = product.variants.first.id %}
      {% if cart_items contains variantId %}
        #featured-product-{{ variantId }} {
          display: none;
        }
      {% endif %}
    {% endfor %}
  </style>
{% endcomment %}

<featured-products data-collection="featured-products" data-section-id="{{ section.id }}">
  {% assign cart_items = cart.items | map: 'variant_id' %}
  <div class="featured-products">
    <h2 class="featured-products__heading">Featured Products</h2>
    <div class="featured-products__list" id="featured-products-list-container">
      {% for product in collections['featured-products'].products %}
        {% render 'featured-products-item', product: product, cart_items: cart_items %}
      {% endfor %}
    </div>
  </div>
</featured-products>
