<div class="featured-products">
  <h2 class="featured-products__title">Featured Products</h2>
  <div class="featured-products__list" id="featured-products-list-container">
    {% for product in collections['featured-products'].products %}
      <article class="featured-products__item" data-variant-id="{{ product.variants.first.id }}">
        <a href="{{ product.url }}" class="featured-products__link">
          {% if product.featured_image %}
            <picture class="featured-products__image-container">
              <source media="(min-width: 1200px)" srcset="{{ product.featured_image.src | img_url: '2048x2048' }}">
              <source media="(min-width: 768px)" srcset="{{ product.featured_image.src | img_url: '1024x1024' }}">
              <img
                class="featured-products__image"
                src="{{ product.featured_image.src | img_url: '500x500' }}"
                alt="{{ product.title }}"
                loading="lazy">
            </picture>
          {% endif %}
          <h3 class="featured-products__title">{{ product.title }}</h3>
          <button class="featured-products__add-to-cart" data-variant-id="{{ product.variants.first.id }}">
            Add to Cart -
            <span class="featured-products__price">{{ product.price | money }}</span>
          </button>
        </a>
      </article>
    {% endfor %}
  </div>

  <featured-products data-collection="featured-products" data-section-id="{{ section.id }}"></featured-products>
</div>